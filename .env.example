# ─────────────────────────────────────────────────────────────
# TripNest — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Database
APP_PROFILE=local                         # local (MySQL) | postgres (PostgreSQL)
MYSQL_ROOT_PASSWORD=swami@06
DB_PASSWORD=swami@06                      # PostgreSQL password

# JWT
JWT_SECRET=TripNestSuperSecretKeyChangeThisInProduction1234567890

# Gmail SMTP (get App Password from Google Account → Security)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx        # 16-char App Password

# Frontend URL used in email links
FRONTEND_URL=http://localhost:3000

# Google OAuth2 (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────────────────────
# Frontend environment variables (React)
# Place these in tripnest/frontend/.env
# ─────────────────────────────────────────────────────────────

# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
REACT_APP_OPENWEATHER_API_KEY=your-openweather-api-key
