# Copy to .env (or export in your shell / CI) — never commit real secrets.

SPRING_PROFILES_ACTIVE=dev

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tripnest_dev
DB_USERNAME=root
DB_PASSWORD=root

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-real-256-bit-base64-secret

# Google OAuth2 (create credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

SERVER_PORT=8080
