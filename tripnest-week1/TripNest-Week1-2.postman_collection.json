{
  "info": {
    "name": "TripNest - Week 1 & 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Keerthana\",\n  \"email\": \"keerthana@tripnest.com\",\n  \"password\": \"test123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "2. Login (copy token from response into {{token}})",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"keerthana@tripnest.com\",\n  \"password\": \"test123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "3. Get My Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "4. Update My Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Keerthana Updated\"\n}"
        },
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "5. Change Password",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"test123\",\n  \"newPassword\": \"newpass456\"\n}"
        },
        "url": "{{baseUrl}}/api/users/me/password"
      }
    },
    {
      "name": "6. Admin-Only Endpoint (expect 403 as TRAVELER)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/admin/dashboard-stub"
      }
    },
    {
      "name": "7. Create Destination (ADMINISTRATOR only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Goa\",\n  \"country\": \"India\",\n  \"description\": \"Beaches and nightlife\",\n  \"imageUrl\": \"\",\n  \"popularAttractions\": \"Baga Beach, Fort Aguada\"\n}"
        },
        "url": "{{baseUrl}}/api/destinations"
      }
    },
    {
      "name": "8. Browse Destinations (public, no token needed)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/destinations"
      }
    },
    {
      "name": "9. Create Trip",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Goa Weekend\",\n  \"destinationId\": 1,\n  \"startDate\": \"2026-08-10\",\n  \"endDate\": \"2026-08-13\",\n  \"budget\": 15000\n}"
        },
        "url": "{{baseUrl}}/api/trips"
      }
    },
    {
      "name": "10. Get My Trips",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/trips"
      }
    },
    {
      "name": "11. Add Itinerary Day 1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayNumber\": 1,\n  \"date\": \"2026-08-10\",\n  \"notes\": \"Arrival day\"\n}"
        },
        "url": "{{baseUrl}}/api/trips/1/itineraries"
      }
    },
    {
      "name": "12. Add Activity to Day 1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Check in to hotel\",\n  \"type\": \"ACCOMMODATION\",\n  \"scheduledTime\": \"14:00:00\",\n  \"location\": \"Taj Resort\",\n  \"notes\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/itineraries/1/activities"
      }
    },
    {
      "name": "13. Trip Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/trips/1/dashboard"
      }
    },
    {
      "name": "14. Add Traveler to Trip",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"someoneelse@tripnest.com\"\n}"
        },
        "url": "{{baseUrl}}/api/trips/1/travelers"
      }
    }
  ]
}
